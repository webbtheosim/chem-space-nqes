bg_color white
set depth_cue, 0  ;# ← DISABLE fog effect
load mol_87.mol, mol_87
util.cbac
set orthoscopic, on
color gray, elem C
color white, elem H
color red, elem O
color blue, elem N
color white, elem H
color yellow, elem S
color green, elem Cl
color cyan, elem F
color brown, elem Br
color purple, elem I
hide everything, mol_87
show sticks, mol_87
show spheres, mol_87
set depth_cue, 0, mol_87
set transparency, 0, mol_87
set sphere_transparency, 0, mol_87
set stick_transparency, 0, mol_87
set sphere_scale, 0.25, mol_87
orient mol_87
zoom mol_87, buffer=1.5
ray 10000, 10000
png images/mol_87.png
delete mol_87
